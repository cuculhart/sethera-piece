{
  "name": "sethera-piece",
  "private": true,
  "version": "2.0.0",
  "description": "Sethera Piece — freeform visual board with live calculations. No cells, just pieces. Rebuilt on the Kimetron engine (kimetron/ is a vendored copy).",
  "type": "module",
  "workspaces": [
    "kimetron/packages/*",
    "app"
  ],
  "scripts": {
    "dev": "npm run dev -w sethera-app",
    "build": "npm run build -w sethera-app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
